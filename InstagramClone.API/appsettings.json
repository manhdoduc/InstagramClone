{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq_logs",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "InstagramClone.API"
    }
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:5174",
    "http://localhost:5242",
    "http://localhost:5063",
    "http://localhost:44391",
    "https://localhost:44391",
    "http://instagramclone.web:8080"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "redis:6379,abortConnect=false"
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "MiniInstaApi",
    "Audience": "MiniInstaUsers",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryTime": 7
  },
  "MediaSettings": {
    "MaxFileSizeBytes": 5242880,
    "Avatar": {
      "MaxWidth": 500,
      "MaxHeight": 500
    },
    "Post": {
      "MaxWidth": 1080,
      "MaxHeight": 1350
    },
    "ChatImage": {
      "MaxWidth": 400,
      "MaxHeight": 400
    }
  }
}