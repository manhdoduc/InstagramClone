@namespace InstagramClone.Web.Components.Notifications
@inject IFollowService FollowService
@inject INotificationService NotificationService
@inject NavigationManager Navigation

<div @onclick="HandleNotificationClick" 
     class="flex items-center justify-between p-3 rounded-xl cursor-pointer transition-colors hover:bg-neutral-900 border border-transparent hover:border-neutral-800 select-none @(!Notification.IsRead ? "bg-neutral-900/60" : "")">
    <div class="flex items-center space-x-3 flex-1 min-w-0 mr-3">
        <a href="@($"/profile/{Notification.ActorId}")" @onclick:stopPropagation class="flex-shrink-0">
            <Avatar AvatarUrl="@Notification.ActorAvatarUrl" Alt="@Notification.ActorUsername" Size="md" />
        </a>

        <div class="flex flex-col text-xs leading-relaxed truncate">
            <p class="text-white truncate">
                <span class="font-bold mr-1">@Notification.ActorUsername</span>
                <span class="text-neutral-300">@Notification.Message</span>
            </p>
            <span class="text-[10px] text-neutral-500 font-medium">
                @DateTimeHelper.ToRelativeTime(Notification.CreatedAt)
            </span>
        </div>
    </div>

    <!-- Action Button / Follow Request Actions -->
    <div class="flex items-center space-x-2 flex-shrink-0">
        @if (Notification.Type == NotificationType.FollowRequest)
        {
            @if (_requestHandled)
            {
                <span class="text-xs font-semibold text-neutral-400">@_statusText</span>
            }
            else
            {
                <button @onclick="AcceptRequest" @onclick:stopPropagation class="px-3 py-1 bg-insta-blue hover:bg-insta-blue-hover text-white font-semibold text-xs rounded-lg transition-colors">
                    Chấp nhận
                </button>
                <button @onclick="DeclineRequest" @onclick:stopPropagation class="px-3 py-1 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-semibold text-xs rounded-lg transition-colors">
                    Xóa
                </button>
            }
        }
        else if (!Notification.IsRead)
        {
            <span class="w-2 h-2 rounded-full bg-insta-blue"></span>
        }
    </div>
</div>

@code {
    [Parameter] public NotificationDto Notification { get; set; } = new();
    [Parameter] public EventCallback<NotificationDto> OnItemClicked { get; set; }

    private bool _requestHandled = false;
    private string _statusText = string.Empty;

    private async Task HandleNotificationClick()
    {
        if (!Notification.IsRead)
        {
            Notification.IsRead = true;
            await NotificationService.MarkAsReadAsync(Notification.Id);
        }

        if (Notification.TargetId.HasValue)
        {
            if (Notification.Type == NotificationType.LikePost || Notification.Type == NotificationType.Comment)
            {
                Navigation.NavigateTo("");
            }
            else if (Notification.Type == NotificationType.Follow)
            {
                Navigation.NavigateTo($"/profile/{Notification.ActorId}");
            }
        }
        else
        {
            Navigation.NavigateTo($"/profile/{Notification.ActorId}");
        }

        await OnItemClicked.InvokeAsync(Notification);
    }

    private async Task AcceptRequest()
    {
        _requestHandled = true;
        _statusText = "Đã đồng ý";
        await FollowService.AcceptFollowRequestAsync(Notification.ActorId);
    }

    private async Task DeclineRequest()
    {
        _requestHandled = true;
        _statusText = "Đã gỡ";
        await FollowService.DeclineFollowRequestAsync(Notification.ActorId);
    }
}
