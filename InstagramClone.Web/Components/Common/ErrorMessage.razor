@namespace InstagramClone.Web.Components.Common

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="bg-red-900/30 border border-red-800 text-red-400 text-xs px-4 py-3 rounded-lg flex items-start justify-between space-x-2 my-2 animate-fade-in" role="alert">
        <div class="flex items-center space-x-2">
            <i class="fa-solid fa-circle-exclamation text-red-500 text-sm flex-shrink-0"></i>
            <span>@Message</span>
        </div>
        @if (OnRetry.HasDelegate)
        {
            <button @onclick="OnRetry" class="text-xs font-semibold text-red-300 hover:text-red-100 underline transition-colors">
                Thử lại
            </button>
        }
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
