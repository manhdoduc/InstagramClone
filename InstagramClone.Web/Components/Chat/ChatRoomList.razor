@namespace InstagramClone.Web.Components.Chat
@inject AppState AppState

<div class="flex flex-col h-full bg-black border-r border-neutral-800 select-none">
    <!-- Header -->
    <div class="p-4 border-b border-neutral-800 flex items-center justify-between">
        <h2 class="text-base font-bold text-white tracking-tight">Tin nhắn</h2>
        <div class="flex items-center space-x-1">
            <button @onclick="OnNewGroupClicked" class="text-neutral-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-neutral-800" title="Tạo nhóm chat mới">
                <i class="fa-solid fa-users text-sm"></i>
            </button>
            <button @onclick="OnNewChatClicked" class="text-neutral-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-neutral-800" title="Gửi tin nhắn trực tiếp">
                <i class="fa-regular fa-pen-to-square text-base"></i>
            </button>
        </div>
    </div>

    <!-- Search Input -->
    <div class="p-3 border-b border-neutral-800/60">
        <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-neutral-500 text-xs"></i>
            <input type="text" 
                   @bind="_searchFilter" 
                   @bind:event="oninput" 
                   placeholder="Tìm cuộc trò chuyện..." 
                   class="w-full pl-9 pr-3 py-1.5 bg-neutral-900 border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-700" />
        </div>
    </div>

    <!-- Rooms List -->
    <div class="flex-1 overflow-y-auto p-2 space-y-1">
        @if (Rooms != null && Rooms.Count > 0)
        {
            @foreach (var room in FilteredRooms)
            {
                var r = room;
                var isSelected = r.Id == SelectedRoomId;

                <div @onclick="() => SelectRoom(r.Id)" 
                     class="flex items-center space-x-3 p-3 rounded-xl cursor-pointer transition-colors hover:bg-neutral-900 @(isSelected ? "bg-neutral-900 border border-neutral-800" : "")">
                    
                    <Avatar AvatarUrl="" Alt="@(r.RoomName ?? "Phòng chat")" Size="md" />

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between">
                            <h3 class="text-xs font-semibold text-white truncate">
                                @(r.RoomName ?? "Trò chuyện trực tiếp")
                            </h3>
                            @if (r.LatestMessageAt.HasValue)
                            {
                                <span class="text-[10px] text-neutral-500">
                                    @DateTimeHelper.ToRelativeTime(r.LatestMessageAt.Value)
                                </span>
                            }
                        </div>
                        <div class="flex items-center justify-between mt-0.5">
                            <p class="text-[11px] text-neutral-400 truncate max-w-[140px]">
                                @(r.LatestMessage ?? "Bắt đầu cuộc trò chuyện")
                            </p>
                            @if (r.UnreadMessagesCount > 0)
                            {
                                <span class="bg-insta-blue text-white text-[10px] font-bold h-4 w-4 rounded-full flex items-center justify-center">
                                    @(r.UnreadMessagesCount > 9 ? "9+" : r.UnreadMessagesCount)
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="p-6 text-center text-xs text-neutral-500 space-y-2">
                <i class="fa-regular fa-comments text-2xl text-neutral-600"></i>
                <p>Chưa có cuộc trò chuyện nào.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<ChatRoomDto> Rooms { get; set; } = new();
    [Parameter] public Guid SelectedRoomId { get; set; }
    [Parameter] public EventCallback<Guid> OnRoomSelected { get; set; }
    [Parameter] public EventCallback OnNewChat { get; set; }
    [Parameter] public EventCallback OnNewGroup { get; set; }

    private string _searchFilter = string.Empty;

    private IEnumerable<ChatRoomDto> FilteredRooms => string.IsNullOrWhiteSpace(_searchFilter)
        ? Rooms
        : Rooms.Where(r => (r.RoomName ?? "").Contains(_searchFilter, StringComparison.OrdinalIgnoreCase)
                        || (r.LatestMessage ?? "").Contains(_searchFilter, StringComparison.OrdinalIgnoreCase));

    private async Task SelectRoom(Guid roomId)
    {
        await OnRoomSelected.InvokeAsync(roomId);
    }

    private async Task OnNewChatClicked()
    {
        await OnNewChat.InvokeAsync();
    }

    private async Task OnNewGroupClicked()
    {
        await OnNewGroup.InvokeAsync();
    }
}
