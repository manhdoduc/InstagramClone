@page "/notifications"
@attribute [Authorize]
@inject INotificationService NotificationService
@inject NotificationHubService NotificationHub
@inject AppState AppState
@implements IAsyncDisposable

<PageTitle>Thông báo • Instagram</PageTitle>

<div class="max-w-[700px] mx-auto px-4 py-8 space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-neutral-800">
        <div class="flex items-center space-x-3">
            <i class="fa-regular fa-heart text-xl text-white"></i>
            <h1 class="text-xl font-bold text-white">Thông báo</h1>
        </div>

        @if (_notifications.Any(n => !n.IsRead))
        {
            <button @onclick="MarkAllRead" class="text-xs font-semibold text-insta-blue hover:text-white transition-colors">
                Đánh dấu tất cả là đã đọc
            </button>
        }
    </div>

    <!-- Notification List -->
    @if (_isLoading)
    {
        <LoadingSpinner Size="lg" Text="Đang tải thông báo..." />
    }
    else if (_notifications.Count > 0)
    {
        <InfiniteScroll HasNextPage="_hasNextPage" IsLoading="_isLoadingMore" OnLoadMore="LoadMoreNotifications">
            <div class="space-y-2">
                @foreach (var notification in _notifications)
                {
                    var n = notification;
                    <NotificationItem Notification="n" OnItemClicked="HandleItemClicked" />
                }
            </div>
        </InfiniteScroll>
    }
    else
    {
        <EmptyState Title="Chưa có thông báo nào" 
                    Description="Khi có người thích bài viết, bình luận hoặc theo dõi bạn, thông báo sẽ hiển thị ở đây." 
                    IconClass="fa-regular fa-heart" />
    }
</div>

@code {
    private List<NotificationDto> _notifications = new();
    private bool _isLoading = true;
    private bool _isLoadingMore = false;
    private bool _hasNextPage = false;
    private DateTime? _nextCursor;

    protected override async Task OnInitializedAsync()
    {
        NotificationHub.OnNotificationReceived += HandleRealtimeNotification;
        await NotificationHub.StartAsync();
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        _isLoading = true;
        var result = await NotificationService.GetNotificationsAsync(new PaginationRequest { PageSize = 20 });
        if (result.IsSuccess && result.Data != null)
        {
            _notifications = result.Data.Items;
            _hasNextPage = result.Data.HasNextPage;
            _nextCursor = result.Data.NextCursor;
        }
        _isLoading = false;
    }

    private async Task LoadMoreNotifications()
    {
        if (_isLoadingMore || !_hasNextPage) return;

        _isLoadingMore = true;
        var result = await NotificationService.GetNotificationsAsync(new PaginationRequest { PageSize = 20, Cursor = _nextCursor });
        if (result.IsSuccess && result.Data != null)
        {
            _notifications.AddRange(result.Data.Items);
            _hasNextPage = result.Data.HasNextPage;
            _nextCursor = result.Data.NextCursor;
        }
        _isLoadingMore = false;
    }

    private void HandleRealtimeNotification(NotificationDto notification)
    {
        InvokeAsync(() =>
        {
            _notifications.Insert(0, notification);
            StateHasChanged();
        });
    }

    private async Task MarkAllRead()
    {
        foreach (var n in _notifications)
        {
            n.IsRead = true;
        }
        AppState.MarkAllRead();
        await NotificationService.MarkAllAsReadAsync();
    }

    private void HandleItemClicked(NotificationDto notification)
    {
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        NotificationHub.OnNotificationReceived -= HandleRealtimeNotification;
    }
}
