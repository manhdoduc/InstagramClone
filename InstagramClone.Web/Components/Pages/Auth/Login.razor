@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider

<PageTitle>Đăng nhập • Instagram</PageTitle>

<div class="flex items-center justify-center w-full max-w-4xl mx-auto py-8">
    <!-- Left Column: Instagram Phone Frame Showcase (Desktop Only) -->
    <div class="hidden md:block relative w-[380px] h-[580px] mr-8 select-none">
        <div class="absolute inset-0 bg-neutral-900 border-[10px] border-neutral-800 rounded-[45px] shadow-2xl overflow-hidden flex items-center justify-center">
            <!-- Mock Phone Display Content -->
            <div class="w-full h-full bg-gradient-to-b from-neutral-900 via-black to-neutral-900 p-6 flex flex-col justify-between items-center text-center">
                <div class="pt-8 space-y-2">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-yellow-500 via-red-500 to-purple-600 p-[2px] mx-auto shadow-lg">
                        <div class="w-full h-full bg-black rounded-[14px] flex items-center justify-center">
                            <i class="fa-brands fa-instagram text-3xl text-white"></i>
                        </div>
                    </div>
                    <h2 class="text-lg font-bold tracking-tight text-white font-sans">Instagram Clone</h2>
                    <p class="text-xs text-neutral-400">Chia sẻ khoảnh khắc, kết nối bạn bè mọi lúc mọi nơi.</p>
                </div>

                <!-- Showcase Mock Image -->
                <div class="w-full aspect-[4/5] rounded-2xl bg-neutral-800 border border-neutral-700/50 overflow-hidden relative shadow-inner">
                    <div class="absolute inset-0 bg-gradient-to-tr from-insta-pink/20 via-purple-900/20 to-insta-blue/20 flex items-center justify-center">
                        <div class="space-y-3 px-4">
                            <div class="flex items-center justify-center space-x-2">
                                <Avatar Alt="Antigravity" Size="sm" HasStory="true" />
                                <span class="text-xs font-semibold text-white">Antigravity .NET 8</span>
                            </div>
                            <p class="text-[11px] text-neutral-300 italic">"Giao diện hiện đại, tối giản & responsive với Tailwind CSS."</p>
                        </div>
                    </div>
                </div>

                <p class="pb-4 text-[10px] text-neutral-500">© 2026 Antigravity Deepmind Team</p>
            </div>
        </div>
    </div>

    <!-- Right Column: Login Card Form -->
    <div class="w-full max-w-sm space-y-3">
        <!-- Main Form Box -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-8 space-y-6 shadow-xl">
            <!-- Brand Header -->
            <div class="text-center space-y-2">
                <h1 class="text-3xl font-bold tracking-tight text-white font-sans">Instagram</h1>
                <p class="text-xs text-neutral-400">Đăng nhập để xem ảnh và video từ bạn bè.</p>
            </div>

            <!-- Error Banner -->
            <ErrorMessage Message="@_errorMessage" />

            <!-- Login Form -->
            <EditForm Model="_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="space-y-3">
                    <div>
                        <InputText @bind-Value="_loginModel.Email" 
                                   placeholder="Email" 
                                   class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                        <ValidationMessage For="() => _loginModel.Email" class="text-red-400 text-[11px] mt-1" />
                    </div>

                    <div>
                        <InputText @bind-Value="_loginModel.Password" 
                                   type="password" 
                                   placeholder="Mật khẩu" 
                                   class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                        <ValidationMessage For="() => _loginModel.Password" class="text-red-400 text-[11px] mt-1" />
                    </div>

                    <button type="submit" 
                            disabled="@_isLoading" 
                            class="w-full py-2.5 bg-insta-blue hover:bg-insta-blue-hover text-white font-semibold text-xs rounded-lg transition-colors flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed">
                        @if (_isLoading)
                        {
                            <i class="fa-solid fa-circle-notch animate-spin text-sm"></i>
                            <span>Đang đăng nhập...</span>
                        }
                        else
                        {
                            <span>Đăng nhập</span>
                        }
                    </button>
                </div>
            </EditForm>

            <!-- Divider -->
            <div class="flex items-center space-x-3 select-none">
                <div class="flex-1 h-px bg-neutral-800"></div>
                <span class="text-[11px] font-semibold text-neutral-500">HOẶC</span>
                <div class="flex-1 h-px bg-neutral-800"></div>
            </div>

            <!-- Demo Account Quick Login (Tiện lợi cho dev/test) -->
            <div class="text-center">
                <button type="button" @onclick="FillDemoCredentials" class="text-xs font-semibold text-insta-blue hover:text-white transition-colors">
                    <i class="fa-solid fa-bolt mr-1"></i>Điền tài khoản dùng thử
                </button>
            </div>
        </div>

        <!-- Register Link Box -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-4 text-center text-xs text-neutral-400">
            Bạn chưa có tài khoản? 
            <a href="register" class="font-semibold text-insta-blue hover:text-white transition-colors ml-1">
                Đăng ký ngay
            </a>
        </div>
    </div>
</div>

@code {
    private readonly LoginRequest _loginModel = new();
    private string? _errorMessage;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthStateProvider.GetCurrentUserAsync();
        if (currentUser.IsAuthenticated)
        {
            Navigation.NavigateTo("", replace: true);
        }
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(_loginModel);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("", replace: true);
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Đăng nhập thất bại. Vui lòng kiểm tra lại email và mật khẩu.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Đã xảy ra lỗi: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FillDemoCredentials()
    {
        _loginModel.Email = "test123@example.com";
        _loginModel.Password = "Test@1234";
    }
}
