@page "/register"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider

<PageTitle>Đăng ký • Instagram</PageTitle>

<div class="flex items-center justify-center w-full max-w-md mx-auto py-8">
    <div class="w-full space-y-3">
        <!-- Main Form Box -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-8 space-y-5 shadow-xl">
            <!-- Brand Header -->
            <div class="text-center space-y-2">
                <h1 class="text-3xl font-bold tracking-tight text-white font-sans">Instagram</h1>
                <p class="text-xs text-neutral-400 font-medium">Đăng ký để xem ảnh và video từ bạn bè của bạn.</p>
            </div>

            <!-- Error / Success Banners -->
            <ErrorMessage Message="@_errorMessage" />

            @if (_isSuccess)
            {
                <div class="bg-green-900/30 border border-green-800 text-green-400 text-xs px-4 py-3 rounded-lg flex items-center space-x-2 animate-fade-in">
                    <i class="fa-solid fa-circle-check text-green-500 text-sm"></i>
                    <span>Tạo tài khoản thành công! Đang chuyển hướng đến trang đăng nhập...</span>
                </div>
            }

            <!-- Register Form -->
            <EditForm Model="_registerModel" OnValidSubmit="HandleRegister" FormName="RegisterForm">
                <DataAnnotationsValidator />

                <div class="space-y-3">
                    <!-- First Name & Last Name Grid -->
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <InputText @bind-Value="_registerModel.FirstName" 
                                       placeholder="Họ" 
                                       class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                            <ValidationMessage For="() => _registerModel.FirstName" class="text-red-400 text-[11px] mt-1" />
                        </div>
                        <div>
                            <InputText @bind-Value="_registerModel.LastName" 
                                       placeholder="Tên" 
                                       class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                            <ValidationMessage For="() => _registerModel.LastName" class="text-red-400 text-[11px] mt-1" />
                        </div>
                    </div>

                    <div>
                        <InputText @bind-Value="_registerModel.UserName" 
                                   placeholder="Tên người dùng (Username)" 
                                   class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                        <ValidationMessage For="() => _registerModel.UserName" class="text-red-400 text-[11px] mt-1" />
                    </div>

                    <div>
                        <InputText @bind-Value="_registerModel.Email" 
                                   placeholder="Email" 
                                   class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                        <ValidationMessage For="() => _registerModel.Email" class="text-red-400 text-[11px] mt-1" />
                    </div>

                    <div>
                        <InputText @bind-Value="_registerModel.Password" 
                                   type="password" 
                                   placeholder="Mật khẩu (tối thiểu 6 ký tự)" 
                                   class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                        <ValidationMessage For="() => _registerModel.Password" class="text-red-400 text-[11px] mt-1" />
                    </div>

                    <div>
                        <InputText @bind-Value="_registerModel.ConfirmPassword" 
                                   type="password" 
                                   placeholder="Xác nhận mật khẩu" 
                                   class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors" />
                        <ValidationMessage For="() => _registerModel.ConfirmPassword" class="text-red-400 text-[11px] mt-1" />
                    </div>

                    <p class="text-[11px] text-neutral-500 text-center leading-relaxed">
                        Bằng cách đăng ký, bạn đồng ý với Điều khoản, Chính sách dữ liệu và Chính sách cookie của chúng tôi.
                    </p>

                    <button type="submit" 
                            disabled="@(_isLoading || _isSuccess)" 
                            class="w-full py-2.5 bg-insta-blue hover:bg-insta-blue-hover text-white font-semibold text-xs rounded-lg transition-colors flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed">
                        @if (_isLoading)
                        {
                            <i class="fa-solid fa-circle-notch animate-spin text-sm"></i>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <span>Đăng ký</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>

        <!-- Login Link Box -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-4 text-center text-xs text-neutral-400">
            Bạn đã có tài khoản? 
            <a href="login" class="font-semibold text-insta-blue hover:text-white transition-colors ml-1">
                Đăng nhập
            </a>
        </div>
    </div>
</div>

@code {
    private readonly RegisterRequest _registerModel = new();
    private string? _errorMessage;
    private bool _isLoading = false;
    private bool _isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthStateProvider.GetCurrentUserAsync();
        if (currentUser.IsAuthenticated)
        {
            Navigation.NavigateTo("", replace: true);
        }
    }

    private async Task HandleRegister()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.RegisterAsync(_registerModel);
            if (result.IsSuccess)
            {
                _isSuccess = true;
                await Task.Delay(1500);
                Navigation.NavigateTo("login");
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Đăng ký thất bại. Vui lòng kiểm tra lại thông tin đăng ký.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Đã xảy ra lỗi: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
