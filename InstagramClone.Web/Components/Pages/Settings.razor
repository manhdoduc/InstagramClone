@page "/settings"
@attribute [Authorize]
@inject IUserService UserService
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Cài đặt • Instagram</PageTitle>

<div class="max-w-[800px] mx-auto px-4 py-8 space-y-8 select-none">
    <!-- Header -->
    <div class="pb-4 border-b border-neutral-800">
        <h1 class="text-xl font-bold text-white">Cài đặt tài khoản</h1>
        <p class="text-xs text-neutral-400">Quản lý hồ sơ cá nhân và quyền riêng tư của bạn.</p>
    </div>

    <!-- Alert Banners -->
    <ErrorMessage Message="@_errorMessage" />

    @if (_successMessage != null)
    {
        <div class="bg-green-900/30 border border-green-800 text-green-400 text-xs px-4 py-3 rounded-lg flex items-center space-x-2 animate-fade-in">
            <i class="fa-solid fa-circle-check text-green-500 text-sm"></i>
            <span>@_successMessage</span>
        </div>
    }

    <!-- Profile Edit Section -->
    @if (_isLoading)
    {
        <LoadingSpinner Size="lg" Text="Đang tải thông tin..." />
    }
    else if (_profile != null)
    {
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 space-y-6">
            <h2 class="text-sm font-bold text-white uppercase tracking-wider text-neutral-400">Chỉnh sửa hồ sơ</h2>

            <!-- Avatar Change -->
            <div class="flex items-center space-x-6 pb-6 border-b border-neutral-800">
                <Avatar AvatarUrl="@_profile.AvatarUrl" Alt="@_profile.FullName" Size="xl" />
                <div class="space-y-2">
                    <p class="text-sm font-semibold text-white">@_profile.FullName</p>
                    <div class="flex items-center space-x-3">
                        <div class="relative">
                            <InputFile OnChange="HandleAvatarSelected" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
                            <button type="button" class="px-3.5 py-1.5 bg-insta-blue hover:bg-insta-blue-hover text-white text-xs font-semibold rounded-lg transition-colors">
                                @(_isUploadingAvatar ? "Đang tải..." : "Đổi ảnh đại diện")
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_profile.AvatarUrl))
                        {
                            <button type="button" @onclick="HandleDeleteAvatar" class="px-3.5 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-red-400 text-xs font-semibold rounded-lg transition-colors">
                                Xóa ảnh
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Bio Textarea -->
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-neutral-300">Tiểu sử (Bio)</label>
                <textarea @bind="_bioText" 
                          rows="3" 
                          placeholder="Viết một chút về bản thân bạn..." 
                          class="w-full px-3.5 py-2.5 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition-colors resize-none"></textarea>
                <div class="flex justify-end">
                    <button type="button" @onclick="HandleSaveBio" disabled="@_isSavingBio" class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-semibold rounded-lg transition-colors">
                        @(_isSavingBio ? "Đang lưu..." : "Lưu tiểu sử")
                    </button>
                </div>
            </div>

            <!-- Privacy Toggle Section -->
            <div class="pt-6 border-t border-neutral-800 space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-white">Tài khoản riêng tư (Private Account)</p>
                        <p class="text-[11px] text-neutral-400 max-w-sm">
                            Khi tài khoản của bạn ở chế độ riêng tư, chỉ những người bạn chấp nhận mới có thể xem ảnh và video của bạn.
                        </p>
                    </div>
                    <button type="button" @onclick="HandleTogglePrivacy" class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none @(_profile.IsPrivateAccount ? "bg-insta-blue" : "bg-neutral-800")">
                        <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out @(_profile.IsPrivateAccount ? "translate-x-5" : "translate-x-0")"></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Security Placeholder Card -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 space-y-3 opacity-75">
            <div class="flex items-center space-x-2 text-neutral-400">
                <i class="fa-solid fa-shield-halved text-sm"></i>
                <h2 class="text-xs font-bold uppercase tracking-wider">Bảo mật & Đổi mật khẩu</h2>
            </div>
            <p class="text-xs text-neutral-400">
                Tính năng xác thực Email & Đổi mật khẩu nâng cao đang được phát triển và sẽ ra mắt ở phiên bản tiếp theo.
            </p>
        </div>

        <!-- Logout Action Button -->
        <div class="pt-4 text-center">
            <button type="button" @onclick="HandleLogout" class="px-6 py-2.5 bg-red-900/30 hover:bg-red-900/50 border border-red-800/80 text-red-400 text-xs font-semibold rounded-xl transition-colors">
                <i class="fa-solid fa-right-from-bracket mr-2"></i>Đăng xuất tài khoản
            </button>
        </div>
    }
</div>

@code {
    private UserProfileDto? _profile;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _successMessage;

    private string _bioText = string.Empty;
    private bool _isSavingBio = false;
    private bool _isUploadingAvatar = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _profile == null)
        {
            await LoadUserSettings();
            StateHasChanged();
        }
    }

    private async Task LoadUserSettings()
    {
        _isLoading = true;
        var currentUser = await AuthStateProvider.GetCurrentUserAsync();
        if (!string.IsNullOrWhiteSpace(currentUser.Id))
        {
            var result = await UserService.GetUserProfileAsync(currentUser.Id);
            if (result.IsSuccess && result.Data != null)
            {
                _profile = result.Data;
                _bioText = _profile.Bio ?? string.Empty;
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Không thể tải thông tin người dùng.";
            }
        }
        else
        {
            _errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
        }
        _isLoading = false;
    }

    private async Task HandleSaveBio()
    {
        _isSavingBio = true;
        _errorMessage = null;
        _successMessage = null;

        var result = await UserService.UpdateBioAsync(_bioText);
        if (result.IsSuccess)
        {
            _successMessage = "Cập nhật tiểu sử thành công!";
            if (_profile != null) _profile.Bio = _bioText;
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Cập nhật tiểu sử thất bại.";
        }

        _isSavingBio = false;
    }

    private async Task HandleAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploadingAvatar = true;
        _errorMessage = null;
        _successMessage = null;

        var result = await UserService.UploadAvatarAsync(file);
        if (result.IsSuccess && result.Data != null)
        {
            if (_profile != null) _profile.AvatarUrl = result.Data;
            _successMessage = "Đổi ảnh đại diện thành công!";
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Lỗi tải ảnh đại diện.";
        }
        _isUploadingAvatar = false;
    }

    private async Task HandleDeleteAvatar()
    {
        var result = await UserService.DeleteAvatarAsync();
        if (result.IsSuccess)
        {
            if (_profile != null) _profile.AvatarUrl = string.Empty;
            _successMessage = "Xóa ảnh đại diện thành công!";
        }
    }

    private async Task HandleTogglePrivacy()
    {
        if (_profile == null) return;
        _profile.IsPrivateAccount = !_profile.IsPrivateAccount;

        var result = await UserService.ToggleAccountPrivacyAsync();
        if (!result.IsSuccess)
        {
            _profile.IsPrivateAccount = !_profile.IsPrivateAccount;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
