@page "/chat"
@page "/chat/{RoomId:guid}"
@attribute [Authorize]
@inject IChatService ChatService
@inject ChatHubService ChatHub
@inject IUserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Tin nhắn • Direct</PageTitle>

<div class="max-w-[1200px] mx-auto h-[calc(100vh-65px)] md:h-[calc(100vh-40px)] my-0 md:my-4 bg-black border border-neutral-800 rounded-none md:rounded-2xl overflow-hidden flex flex-col md:flex-row">
    <!-- Left Column: Chat Rooms List (1/3 width on desktop, full width on mobile if no room selected) -->
    <div class="w-full md:w-80 lg:w-96 flex-shrink-0 h-full @(RoomId != Guid.Empty ? "hidden md:block" : "block")">
        @if (_isLoadingRooms)
        {
            <LoadingSpinner Size="md" Text="Đang tải danh sách tin nhắn..." />
        }
        else
        {
            <ChatRoomList Rooms="_rooms" 
                          SelectedRoomId="RoomId" 
                          OnRoomSelected="HandleRoomSelected" 
                          OnNewChat="OpenNewChatModal" 
                          OnNewGroup="OpenNewGroupModal" />
        }
    </div>

    <!-- Right Column: Chat Room Active View (2/3 width on desktop) -->
    <div class="flex-1 flex flex-col h-full bg-neutral-950 relative @(RoomId == Guid.Empty ? "hidden md:flex" : "flex")">
        @if (RoomId == Guid.Empty)
        {
            <!-- Empty State when no room selected -->
            <EmptyState Title="Tin nhắn của bạn" 
                        Description="Gửi ảnh và tin nhắn riêng tư cho bạn bè hoặc nhóm trò chuyện." 
                        IconClass="fa-regular fa-paper-plane" 
                        ActionButtonText="Gửi tin nhắn" 
                        OnAction="OpenNewChatModal" />
        }
        else if (_selectedRoom != null)
        {
            <!-- Active Room Header -->
            <div class="p-3 lg:px-6 lg:py-4 bg-black border-b border-neutral-800 flex items-center justify-between flex-shrink-0 select-none">
                <div class="flex items-center space-x-3">
                    <button @onclick="BackToRoomsList" class="md:hidden text-neutral-400 hover:text-white p-1">
                        <i class="fa-solid fa-chevron-left text-base"></i>
                    </button>
                    <Avatar AvatarUrl="" Alt="@(_selectedRoom.RoomName ?? "Direct")" Size="md" />
                    <div>
                        <h3 class="text-xs lg:text-sm font-bold text-white">@(_selectedRoom.RoomName ?? "Trò chuyện trực tiếp")</h3>
                        <p class="text-[10px] text-neutral-400">@(_selectedRoom.IsGroupChat ? "Nhóm trò chuyện" : "Đang hoạt động")</p>
                    </div>
                </div>
            </div>

            <!-- Messages List Container -->
            <div class="flex-1 overflow-y-auto p-4 space-y-2">
                @if (_isLoadingMessages)
                {
                    <LoadingSpinner Size="md" Text="Đang tải tin nhắn..." />
                }
                else
                {
                    @foreach (var message in _messages)
                    {
                        var m = message;
                        <MessageBubble Message="m" 
                                       IsSentByMe='string.Equals(m.SenderId, _currentUserId, StringComparison.OrdinalIgnoreCase)' 
                                       OnUnsent="HandleMessageUnsent" />
                    }

                    <!-- Typing Indicator -->
                    <TypingIndicator IsTyping="_isRemoteUserTyping" UserName="@_typingUserName" />
                }
            </div>

            <!-- Input Form Bar -->
            <div class="p-3 lg:p-4 bg-black border-t border-neutral-800 flex-shrink-0 select-none">
                <form @onsubmit="SendMessage" @onsubmit:preventDefault class="flex items-center space-x-3 bg-neutral-900 border border-neutral-800 rounded-full px-4 py-2">
                    <!-- Image Attachment Button -->
                    <div class="relative flex-shrink-0">
                        <InputFile OnChange="HandleMediaSelected" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
                        <button type="button" class="text-neutral-400 hover:text-white transition-colors">
                            <i class="fa-regular fa-image text-lg"></i>
                        </button>
                    </div>

                    <!-- Message Text Input -->
                    <input type="text" 
                           @bind="_messageText" 
                           @bind:event="oninput"
                           @onkeyup="HandleInputKeyUp"
                           placeholder="Nhắn tin..." 
                           class="flex-1 bg-transparent text-xs text-white placeholder-neutral-500 focus:outline-none" />

                    <!-- Submit Button -->
                    @if (!string.IsNullOrWhiteSpace(_messageText) || _isUploadingMedia)
                    {
                        <button type="submit" disabled="@_isSending" class="text-xs font-semibold text-insta-blue hover:text-white transition-colors">
                            @if (_isSending || _isUploadingMedia)
                            {
                                <i class="fa-solid fa-circle-notch animate-spin"></i>
                            }
                            else
                            {
                                <span>Gửi</span>
                            }
                        </button>
                    }
                </form>
            </div>
        }
    </div>
</div>

<!-- New Direct / Group Chat Modal -->
<Modal @bind-IsOpen="_isNewChatModalOpen" Title="@(_chatModalTab == "group" ? "Tạo nhóm chat mới" : "Tin nhắn mới")" MaxWidth="md">
    <div class="space-y-4">
        <!-- Tabs -->
        <div class="flex items-center space-x-4 border-b border-neutral-800 pb-2.5 text-xs font-semibold select-none">
            <button type="button" @onclick='() => _chatModalTab = "direct"' class="pb-1 border-b-2 transition-colors @(_chatModalTab == "direct" ? "border-insta-blue text-white" : "border-transparent text-neutral-400 hover:text-white")">
                <i class="fa-regular fa-user mr-1.5"></i> Nhắn tin 1-1
            </button>
            <button type="button" @onclick='() => _chatModalTab = "group"' class="pb-1 border-b-2 transition-colors @(_chatModalTab == "group" ? "border-insta-blue text-white" : "border-transparent text-neutral-400 hover:text-white")">
                <i class="fa-solid fa-users mr-1.5"></i> Tạo nhóm chat
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_groupErrorMessage))
        {
            <div class="p-2.5 bg-red-900/30 border border-red-800/60 rounded-lg text-xs text-red-300">
                @_groupErrorMessage
            </div>
        }

        @if (_chatModalTab == "group")
        {
            <!-- Group Name Input -->
            <div>
                <label class="block text-xs font-semibold text-neutral-300 mb-1">Tên nhóm chat <span class="text-red-400">*</span></label>
                <input type="text" 
                       @bind="_groupName" 
                       @bind:event="oninput" 
                       maxlength="100"
                       placeholder="Ví dụ: Team Du Lịch, Bạn Thân..." 
                       class="w-full px-3 py-2 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-insta-blue" />
            </div>

            <!-- Selected Members Chips -->
            @if (_selectedGroupMembers.Count > 0)
            {
                <div>
                    <label class="block text-[11px] font-semibold text-neutral-400 mb-1.5">
                        Thành viên đã chọn (@_selectedGroupMembers.Count):
                    </label>
                    <div class="flex flex-wrap gap-1.5 max-h-24 overflow-y-auto p-1 bg-neutral-900/50 rounded-lg border border-neutral-800">
                        @foreach (var member in _selectedGroupMembers)
                        {
                            var m = member;
                            <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-insta-blue/20 text-insta-blue border border-insta-blue/40 text-xs">
                                <span>@m.FullName</span>
                                <button type="button" @onclick="() => ToggleGroupMember(m)" class="hover:text-red-400 transition-colors">
                                    <i class="fa-solid fa-xmark text-[10px]"></i>
                                </button>
                            </span>
                        }
                    </div>
                </div>
            }
        }

        <!-- User Search Input -->
        <div>
            <label class="block text-xs font-semibold text-neutral-300 mb-1">
                @(_chatModalTab == "group" ? "Tìm và thêm thành viên vào nhóm" : "Tìm người dùng để nhắn tin")
            </label>
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-neutral-500 text-xs"></i>
                <input type="text" 
                       @bind="_userSearchQuery" 
                       @bind:event="oninput" 
                       @onkeyup="SearchUsersForChat"
                       placeholder="Nhập tên người dùng hoặc @@username..." 
                       class="w-full pl-8 pr-3 py-2 bg-black border border-neutral-800 rounded-lg text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-700" />
            </div>
        </div>

        <!-- Search Results List -->
        @if (_searchResults.Count > 0)
        {
            <div class="max-h-52 overflow-y-auto space-y-1.5 border border-neutral-800 rounded-lg p-2 bg-black">
                @foreach (var user in _searchResults)
                {
                    var u = user;
                    var isSelected = _selectedGroupMembers.Any(m => m.UserId == u.UserId);

                    @if (_chatModalTab == "group")
                    {
                        <div @onclick="() => ToggleGroupMember(u)" class="flex items-center justify-between p-2 hover:bg-neutral-900 rounded-lg cursor-pointer transition-colors @(isSelected ? "bg-neutral-900/80 border border-insta-blue/40" : "")">
                            <div class="flex items-center space-x-3">
                                <Avatar AvatarUrl="@u.AvatarUrl" Alt="@u.FullName" Size="sm" />
                                <div class="flex flex-col">
                                    <span class="text-xs font-semibold text-white">@u.FullName</span>
                                    @if (!string.IsNullOrWhiteSpace(u.UserName))
                                    {
                                        <span class="text-[10px] text-neutral-400">@@@u.UserName</span>
                                    }
                                </div>
                            </div>
                            <div class="w-5 h-5 rounded-full border @(isSelected ? "bg-insta-blue border-insta-blue text-white" : "border-neutral-600") flex items-center justify-center text-[10px] transition-colors">
                                @if (isSelected)
                                {
                                    <i class="fa-solid fa-check"></i>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div @onclick="() => StartPrivateChat(u.UserId)" class="flex items-center justify-between p-2 hover:bg-neutral-900 rounded-lg cursor-pointer transition-colors">
                            <div class="flex items-center space-x-3">
                                <Avatar AvatarUrl="@u.AvatarUrl" Alt="@u.FullName" Size="sm" />
                                <div class="flex flex-col">
                                    <span class="text-xs font-semibold text-white">@u.FullName</span>
                                    @if (!string.IsNullOrWhiteSpace(u.UserName))
                                    {
                                        <span class="text-[10px] text-neutral-400">@@@u.UserName</span>
                                    }
                                </div>
                            </div>
                            <span class="text-xs text-insta-blue font-semibold hover:underline">Nhắn tin</span>
                        </div>
                    }
                }
            </div>
        }

        <!-- Group Create Action Buttons -->
        @if (_chatModalTab == "group")
        {
            <div class="flex justify-end space-x-2 pt-3 border-t border-neutral-800">
                <button type="button" @onclick="() => _isNewChatModalOpen = false" class="px-4 py-2 text-xs font-semibold text-neutral-400 hover:text-white rounded-lg hover:bg-neutral-900 transition">
                    Hủy
                </button>
                <button type="button" 
                        @onclick="CreateGroupChat" 
                        disabled="@(string.IsNullOrWhiteSpace(_groupName) || _selectedGroupMembers.Count == 0 || _isCreatingGroup)" 
                        class="px-5 py-2 text-xs font-semibold text-white bg-insta-blue hover:bg-sky-600 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg transition flex items-center space-x-1.5 shadow">
                    @if (_isCreatingGroup)
                    {
                        <i class="fa-solid fa-spinner fa-spin text-xs"></i>
                        <span>Đang tạo nhóm...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-users text-xs"></i>
                        <span>Tạo nhóm (@_selectedGroupMembers.Count)</span>
                    }
                </button>
            </div>
        }
    </div>
</Modal>

@code {
    [Parameter] public Guid RoomId { get; set; }

    private List<ChatRoomDto> _rooms = new();
    private ChatRoomDto? _selectedRoom;
    private List<MessageDto> _messages = new();

    private bool _isLoadingRooms = true;
    private bool _isLoadingMessages = false;
    private string _currentUserId = string.Empty;

    private string _messageText = string.Empty;
    private bool _isSending = false;
    private bool _isUploadingMedia = false;

    private bool _isRemoteUserTyping = false;
    private string _typingUserName = "Đối phương";

    private bool _isNewChatModalOpen = false;
    private string _chatModalTab = "direct";
    private string _userSearchQuery = string.Empty;
    private List<UserSummaryDto> _searchResults = new();
    private string _groupName = string.Empty;
    private List<UserSummaryDto> _selectedGroupMembers = new();
    private bool _isCreatingGroup = false;
    private string? _groupErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthStateProvider.GetCurrentUserAsync();
        _currentUserId = currentUser.Id;

        ChatHub.OnMessageReceived += HandleRealtimeMessage;
        ChatHub.OnUserTyping += HandleUserTyping;
        ChatHub.OnUserStoppedTyping += HandleUserStoppedTyping;
        ChatHub.OnMessageReacted += HandleMessageReacted;

        await ChatHub.StartAsync();
        await LoadRooms();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var currentUser = await AuthStateProvider.GetCurrentUserAsync();
            _currentUserId = currentUser.Id;
            await ChatHub.StartAsync();
            if (_rooms.Count == 0)
            {
                await LoadRooms();
                StateHasChanged();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RoomId != Guid.Empty)
        {
            _selectedRoom = _rooms.FirstOrDefault(r => r.Id == RoomId);
            await LoadMessages();
            await ChatHub.JoinRoomAsync(RoomId);
            await ChatHub.MarkMessagesAsReadAsync(RoomId);
        }
    }

    private async Task LoadRooms()
    {
        _isLoadingRooms = true;
        var result = await ChatService.GetUserChatRoomsAsync();
        if (result.IsSuccess && result.Data != null)
        {
            _rooms = result.Data;
            if (RoomId != Guid.Empty)
            {
                _selectedRoom = _rooms.FirstOrDefault(r => r.Id == RoomId);
            }
        }
        _isLoadingRooms = false;
    }

    private async Task LoadMessages()
    {
        _isLoadingMessages = true;
        var result = await ChatService.GetMessagesAsync(RoomId, new PaginationRequest { PageSize = 50 });
        if (result.IsSuccess && result.Data != null)
        {
            _messages = result.Data.Items.OrderBy(m => m.CreatedAt).ToList();
        }
        _isLoadingMessages = false;
    }

    private void HandleRoomSelected(Guid roomId)
    {
        Navigation.NavigateTo($"chat/{roomId}");
    }

    private void BackToRoomsList()
    {
        Navigation.NavigateTo("chat");
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText) || _isSending) return;

        _isSending = true;
        var text = _messageText;
        _messageText = string.Empty;

        await ChatHub.StopTypingAsync(RoomId);

        var result = await ChatService.SendMessageAsync(new SendMessageRequest
        {
            ChatRoomId = RoomId,
            Content = text,
            Type = MessageType.Text
        });

        if (result.IsSuccess && result.Data != null)
        {
            _messages.Add(result.Data);
        }

        _isSending = false;
    }

    private async Task HandleMediaSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploadingMedia = true;
        var result = await ChatService.UploadMediaAsync(RoomId, file);
        if (result.IsSuccess && result.Data != null)
        {
            _messages.Add(result.Data);
        }
        _isUploadingMedia = false;
    }

    private async Task HandleInputKeyUp(KeyboardEventArgs e)
    {
        if (!string.IsNullOrWhiteSpace(_messageText))
        {
            await ChatHub.StartTypingAsync(RoomId);
        }
        else
        {
            await ChatHub.StopTypingAsync(RoomId);
        }
    }

    private void HandleRealtimeMessage(MessageDto message)
    {
        if (message.SenderId != _currentUserId)
        {
            InvokeAsync(() =>
            {
                _messages.Add(message);
                _isRemoteUserTyping = false;
                StateHasChanged();
            });
        }
    }

    private void HandleUserTyping(string userId, Guid roomId)
    {
        if (roomId == RoomId && userId != _currentUserId)
        {
            InvokeAsync(() =>
            {
                _isRemoteUserTyping = true;
                StateHasChanged();
            });
        }
    }

    private void HandleUserStoppedTyping(string userId, Guid roomId)
    {
        if (roomId == RoomId && userId != _currentUserId)
        {
            InvokeAsync(() =>
            {
                _isRemoteUserTyping = false;
                StateHasChanged();
            });
        }
    }

    private void HandleMessageUnsent(Guid messageId)
    {
        _messages.RemoveAll(m => m.Id == messageId);
    }

    private void HandleMessageReacted(Guid messageId, string userId, string emoji)
    {
        InvokeAsync(() =>
        {
            var message = _messages.FirstOrDefault(m => m.Id == messageId);
            if (message != null)
            {
                if (message.Reactions == null) message.Reactions = new List<ReactionDto>();

                var existingReaction = message.Reactions.FirstOrDefault(r => r.UserId == userId);
                if (existingReaction != null)
                {
                    if (existingReaction.Emoji == emoji)
                    {
                        message.Reactions.Remove(existingReaction);
                    }
                    else
                    {
                        existingReaction.Emoji = emoji;
                    }
                }
                else
                {
                    message.Reactions.Add(new ReactionDto { UserId = userId, Emoji = emoji });
                }
                
                StateHasChanged();
            }
        });
    }

    private void OpenNewChatModal()
    {
        _chatModalTab = "direct";
        _userSearchQuery = string.Empty;
        _searchResults.Clear();
        _groupErrorMessage = null;
        _isNewChatModalOpen = true;
    }

    private void OpenNewGroupModal()
    {
        _chatModalTab = "group";
        _userSearchQuery = string.Empty;
        _searchResults.Clear();
        _groupName = string.Empty;
        _selectedGroupMembers.Clear();
        _groupErrorMessage = null;
        _isNewChatModalOpen = true;
    }

    private void ToggleGroupMember(UserSummaryDto user)
    {
        if (_selectedGroupMembers.Any(u => u.UserId == user.UserId))
        {
            _selectedGroupMembers.RemoveAll(u => u.UserId == user.UserId);
        }
        else
        {
            _selectedGroupMembers.Add(user);
        }
    }

    private async Task CreateGroupChat()
    {
        if (string.IsNullOrWhiteSpace(_groupName))
        {
            _groupErrorMessage = "Vui lòng nhập tên nhóm chat.";
            return;
        }
        if (_selectedGroupMembers.Count == 0)
        {
            _groupErrorMessage = "Vui lòng chọn ít nhất 1 thành viên cho nhóm.";
            return;
        }

        _isCreatingGroup = true;
        _groupErrorMessage = null;

        var request = new CreateGroupRequest
        {
            GroupName = _groupName.Trim(),
            MemberIds = _selectedGroupMembers.Select(m => m.UserId).ToList()
        };

        var result = await ChatService.CreateGroupRoomAsync(request);
        if (result.IsSuccess && result.Data != Guid.Empty)
        {
            _isNewChatModalOpen = false;
            await LoadRooms();
            Navigation.NavigateTo($"chat/{result.Data}");
        }
        else
        {
            _groupErrorMessage = result.ErrorMessage ?? "Không thể tạo nhóm chat. Vui lòng thử lại.";
        }

        _isCreatingGroup = false;
    }

    private async Task SearchUsersForChat()
    {
        if (string.IsNullOrWhiteSpace(_userSearchQuery)) return;
        var result = await UserService.SearchUsersAsync(_userSearchQuery);
        if (result.IsSuccess && result.Data != null)
        {
            _searchResults = result.Data.Where(u => u.UserId != _currentUserId).ToList();
        }
    }

    private async Task StartPrivateChat(string targetUserId)
    {
        _isNewChatModalOpen = false;
        var result = await ChatService.GetOrCreatePrivateRoomAsync(targetUserId);
        if (result.IsSuccess && result.Data != Guid.Empty)
        {
            await LoadRooms();
            Navigation.NavigateTo($"chat/{result.Data}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        ChatHub.OnMessageReceived -= HandleRealtimeMessage;
        ChatHub.OnUserTyping -= HandleUserTyping;
        ChatHub.OnUserStoppedTyping -= HandleUserStoppedTyping;
        ChatHub.OnMessageReacted -= HandleMessageReacted;
    }
}
