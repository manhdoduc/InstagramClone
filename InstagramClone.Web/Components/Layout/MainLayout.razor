@inherits LayoutComponentBase
@namespace InstagramClone.Web.Components.Layout
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider

<div class="min-h-screen bg-black text-white flex flex-col md:flex-row">
    <!-- Desktop Sidebar -->
    <Sidebar OnCreatePost="HandleOpenCreatePostModal" />

    <!-- Main Content Container -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen">
        <!-- Mobile TopBar Header -->
        <TopBar />

        <!-- Page Body Content -->
        <main class="flex-1 pb-16 md:pb-0">
            @Body
        </main>
    </div>

    <!-- Mobile Bottom Navigation -->
    <MobileBottomNav OnCreatePost="HandleOpenCreatePostModal" />
</div>

<!-- Global Create Post Modal Placeholder (sẽ kết nối ở Phase 3 Create Post) -->
@if (_isCreatePostOpen)
{
    <InstagramClone.Web.Components.Posts.CreatePostModal @bind-IsOpen="_isCreatePostOpen" />
}

@code {
    private bool _isCreatePostOpen = false;

    private void HandleOpenCreatePostModal()
    {
        _isCreatePostOpen = true;
    }
}
